{
  "name": "app-desktop",
  "version": "1.0.0-beta.1",
  "type": "module",
  "description": "Windows 10/11 Çevrimdışı Arşiv Gezgini ve Dosya Yöneticisi",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilyasbozdemir/dizin-rapor.git"
  },
  "main": "./out/main/index.js",
  "author": "Antigravity",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron .",
    "build": "electron-vite build",
    "build:all": "electron-vite build && electron-builder --win nsis portable --publish never",
    "build:portable": "electron-vite build && electron-builder --win portable --publish never",
    "build:installer": "electron-vite build && electron-builder --win nsis --publish never",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arsiv/core": "workspace:*",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-virtual": "^3.10.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "mammoth": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.4",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.3"
  },
  "build": {
    "appId": "com.arsiv.gezgini",
    "productName": "Arsiv-360",
    "publish": {
      "provider": "github",
      "owner": "ilyasbozdemir",
      "repo": "dizin-rapor"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arşiv 360",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
